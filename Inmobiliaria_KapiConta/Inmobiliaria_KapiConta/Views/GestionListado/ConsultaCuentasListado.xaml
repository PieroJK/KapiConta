<UserControl x:Class="Inmobiliaria_KapiConta.Views.GestionListado.ConsultaCuentasListado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Inmobiliaria_KapiConta.Views.GestionListado"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <!-- 🎨 FONDO GENERAL DEGRADADO -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2C3E50" Offset="0"/>
                <GradientStop Color="#34495E" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 🔝 HEADER -->
        <Border Background="#2C3E50" Padding="10" Grid.ColumnSpan="2">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 🔙 BOTÓN VOLVER -->
                <Button Content="← Volver"
                Background="#C0392B"
                Foreground="White"
                Width="100"
                Margin="5"
                FontWeight="Bold"
                Cursor="Hand"
                Command="{Binding VolverCommand}"/>

                <!-- 📌 CUENTA -->
                <Label Content="Cuenta:"
               Foreground="White"
               VerticalAlignment="Center"
               Margin="10,0,0,0"/>

                <TextBox x:Name="txtCuenta"
                 Text="{Binding CodigoCuenta, UpdateSourceTrigger=PropertyChanged}"
                 Width="120"
                 Margin="5"
                 Padding="3"
                 Background="White"/>

                <!-- 🔎 CONSULTAR -->
                <Button Content="Consultar"
                Background="#3F51B5"
                Foreground="White"
                Width="110"
                Margin="5"
                FontWeight="Bold"
                Cursor="Hand"
                Command="{Binding ConsultarCommand}"/>

                <!-- 📤 EXCEL -->
                <Button Content="Exportar Excel"
                Background="#27AE60"
                Foreground="White"
                Width="150"
                Margin="5"
                FontWeight="Bold"
                Cursor="Hand"
                Command="{Binding ExportarCommand}"/>

            </StackPanel>
        </Border>

        <!-- 📁 PANEL IZQUIERDO -->
        <Border Grid.Row="1"
        Grid.Column="0"
        Margin="5"
        Background="#2C3E50"
        BorderBrush="#A67C52"
        BorderThickness="2"
        CornerRadius="5">

            <ListBox x:Name="lstCuentas"
             ItemsSource="{Binding Cuentas}"
             SelectedItem="{Binding CuentaSeleccionada}"
             DisplayMemberPath="Codigo"
             Background="Transparent"
             BorderThickness="0"
            >

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>

                            <!-- 🎯 SELECCIONADO -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#A67C52"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <!-- 🖱️ HOVER -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E5A73"/>
                            </Trigger>

                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>

            </ListBox>
        </Border>

        <!-- 📊 TABLA -->
        <Border Grid.Row="1"
        Grid.Column="1"
        Margin="5"
        Background="White"
        BorderBrush="#A67C52"
        BorderThickness="2"
        CornerRadius="5">

            <DataGrid x:Name="dgDatos"
              ItemsSource="{Binding Resultados}"
              SelectedItem="{Binding FilaSeleccionada}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Background="White"
              BorderThickness="0"
              MouseDoubleClick="dgDatos_MouseDoubleClick">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mes"       Binding="{Binding Mes}"                   Width="*"/>
                    <DataGridTextColumn Header="Debe"      Binding="{Binding Debe,      StringFormat=N2}" Width="*"/>
                    <DataGridTextColumn Header="Haber"     Binding="{Binding Haber,     StringFormat=N2}" Width="*"/>
                    <DataGridTextColumn Header="Periodo"   Binding="{Binding Periodo,   StringFormat=N2}" Width="*"/>
                    <DataGridTextColumn Header="Acumulado" Binding="{Binding Acumulado, StringFormat=N2}" Width="*"/>
                </DataGrid.Columns>


            </DataGrid>
        </Border>

        <!-- 🧾 TOTAL -->
        <Border Grid.Row="2"
        Grid.Column="1"
        Background="#2C3E50"
        Padding="10">

            <TextBlock x:Name="txtTotal"
               Text="{Binding SaldoTotal}"
               Foreground="White"
               FontWeight="Bold"
               FontSize="16"
               HorizontalAlignment="Right"/>
        </Border>

    </Grid>
</UserControl>
