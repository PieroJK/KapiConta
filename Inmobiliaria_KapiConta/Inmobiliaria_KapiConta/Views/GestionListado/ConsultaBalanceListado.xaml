<UserControl x:Class="Inmobiliaria_KapiConta.Views.GestionListado.ConsultaBalanceListado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Inmobiliaria_KapiConta.Views.GestionListado"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#1E293B">

        <!-- CONTENEDOR PRINCIPAL -->
        <Border Background="#334155" CornerRadius="10" Padding="15" Margin="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 🔹 TÍTULO -->
                <TextBlock Text="Consulta de Balance General"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

                <!-- 🔹 FILTROS -->
                <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" Margin="0,10">

                    <TextBlock Text="Mes Inicio:" Foreground="White" VerticalAlignment="Center" Margin="5"/>

                    <ComboBox ItemsSource="{Binding Meses}"
                              SelectedItem="{Binding MesInicioSeleccionado}"
                              DisplayMemberPath="Nombre"
                              Width="140" Margin="5"/>

                    <TextBlock Text="Mes Fin:" Foreground="White" VerticalAlignment="Center" Margin="5"/>

                    <ComboBox ItemsSource="{Binding Meses}"
                              SelectedItem="{Binding MesFinSeleccionado}"
                              DisplayMemberPath="Nombre"
                              Width="140" Margin="5"/>

                    <Button Content="Consultar"
                        Margin="10,0"
                        Padding="10,5"
                        Background="#3B82F6"
                        Foreground="White"
                        Command="{Binding ConsultarCommand}"/>
                </StackPanel>

                <!-- 🔹 TABLA -->
                <DataGrid x:Name="dgBalanceGeneral"
                      ItemsSource="{Binding Resultados}"
                      Grid.Row="2"
                      Margin="0,15"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      RowBackground="#1E293B"
                      AlternatingRowBackground="#273449"
                      Foreground="#CCFFC857"
                      GridLinesVisibility="None"
                      BorderThickness="0">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código"     Binding="{Binding Codigo}"                        Width="80"/>
                        <DataGridTextColumn Header="Cuenta"     Binding="{Binding Cuenta}"                        Width="2*"/>
                        <DataGridTextColumn Header="Debe"       Binding="{Binding Debe,          StringFormat=N2}" Width="*"/>
                        <DataGridTextColumn Header="Haber"      Binding="{Binding Haber,         StringFormat=N2}" Width="*"/>
                        <DataGridTextColumn Header="Deudor"     Binding="{Binding Deudor,        StringFormat=N2}" Width="*"/>
                        <DataGridTextColumn Header="Acreedor"   Binding="{Binding Acreedor,      StringFormat=N2}" Width="*"/>
                        <DataGridTextColumn Header="Activo"     Binding="{Binding Activo,        StringFormat=N2}" Width="*"/>
                        <DataGridTextColumn Header="Pasivo"     Binding="{Binding Pasivo,        StringFormat=N2}" Width="*"/>
                        <DataGridTextColumn Header="Res. Debe"  Binding="{Binding ResultadoDebe, StringFormat=N2}" Width="*"/>
                        <DataGridTextColumn Header="Res. Haber" Binding="{Binding ResultadoHaber,StringFormat=N2}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 🔹 BOTONES -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Exportar a Excel"
                        Grid.Column="0"
                        Width="180"
                        Height="40"
                        Background="#22C55E"
                        Foreground="White"
                        HorizontalAlignment="Left"
                        Command="{Binding ExcelCommand}"/>

                    <Button Content="Volver"
                        Grid.Column="1"
                        Width="180"
                        Height="40"
                        Background="#EF4444"
                        Foreground="White"
                        HorizontalAlignment="Right"
                        Command="{Binding VolverCommand}"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
