<Window x:Class="Inmobiliaria_KapiConta.Views.GestionAsiento.AgregarDetalleAsientoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Agregar Datos"
        Height="430" Width="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#149191">

    <Grid>
        <Border Margin="8"
                BorderBrush="#B38757"
                BorderThickness="2"
                Background="#2E4458">

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Agregar Datos"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- FILA 1: CUENTA -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Cuenta" Foreground="White" VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Height="26"
                             LostFocus="txtCuentaCodigo_LostFocus"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Text="{Binding CuentaCodigo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding AbrirSelectorCuentaCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBox Grid.Column="3"
                             Height="26"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             Background="#E5E5E5"
                             Text="{Binding CuentaNombre}"/>
                </Grid>

                <!-- FILA 2: DEBE/HABER + IMPORTE + AUTOMATIZACIÓN + TIPO OPERACIÓN -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              Height="26"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding OpcionesDebeHaber}"
                              SelectedItem="{Binding DebeHaberSeleccionado}"/>

                    <TextBox Grid.Column="2"
                             Grid.ColumnSpan="2"
                             Height="26"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Text="{Binding Importe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="5"
                               Text="Asiento automatizado"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <CheckBox Grid.Column="6"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              IsEnabled="{Binding TieneAutomatizacion}"
                              IsChecked="{Binding UsarAutomatizacion}"/>

                    <TextBlock Grid.Column="7"
                               Text="Tipo de Operación"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,8,0"/>

                    <ComboBox Grid.Column="9"
                              Height="26"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding TiposOperacion}"
                              SelectedItem="{Binding TipoOperacionSeleccionado}"
                              DisplayMemberPath="Nombre">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="Black"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </Grid>

                <!-- FILA 3: TIPO DOCUMENTO + DOCUMENTO -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Tipo de Documento"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              Height="26"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding TiposDocumento}"
                              SelectedItem="{Binding TipoDocumentoSeleccionado}"
                              DisplayMemberPath="Cod">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="Black"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <TextBox Grid.Column="3"
                             Height="26"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             Background="#E5E5E5"
                             Text="{Binding TipoDocumentoNombre}"/>

                    <TextBlock Grid.Column="5"
                               Text="Documento"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,8,0"/>

                    <TextBox Grid.Column="6"
                             Height="26"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Text="{Binding Documento, Mode=TwoWay}"/>
                </Grid>

                <!-- FILA 4: RUC + RAZÓN SOCIAL -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="R.U.C." Foreground="White" VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Height="26"
                             LostFocus="txtRuc_LostFocus"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Text="{Binding Ruc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding AbrirSelectorTerceroCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBox Grid.Column="3"
                             Height="26"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             Background="#E5E5E5"
                             Text="{Binding RazonSocial}"/>
                </Grid>

                <!-- FILA 5: GLOSA -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Glosa" Foreground="White" VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Height="26"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Text="{Binding Glosa, Mode=TwoWay}"/>
                </Grid>

                <!-- FILA 6: SALDO + REFERENCIA + BOTONES -->
                <Grid Grid.Row="6" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="/Assets/logo.png"
                           Stretch="Uniform"
                           Height="78"/>

                    <Grid Grid.Column="2" Grid.ColumnSpan="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Saldo Cuenta"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Height="26"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"
                                 Background="#E5E5E5"
                                 Text="{Binding SaldoCuenta}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Asiento Refer."
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Height="26"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding AsientoReferencia, Mode=TwoWay}">
                            <TextBox.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding AbrirSelectorAsientoReferenciaCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>

                    <Button Grid.Column="5"
                            Grid.ColumnSpan="2"
                            Width="130" Height="80"
                            Content="Agregar"
                            Background="#2BBF5A"
                            Foreground="White"
                            FontSize="18"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Command="{Binding AgregarCommand}"/>

                    <Button Grid.Column="8"
                            Grid.ColumnSpan="2"
                            Width="130" Height="80"
                            Content="Cancelar"
                            Background="#D2452D"
                            Foreground="White"
                            FontSize="18"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Command="{Binding CancelarCommand}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>