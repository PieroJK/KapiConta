<UserControl x:Class="Inmobiliaria_KapiConta.Views.GestionAsiento.AsientosWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Inmobiliaria_KapiConta.Views.GestionAsiento"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1400">
    <Grid>
        <Rectangle Fill="#149191"/>

        <Image Source="/Assets/capibara.png"
           Stretch="Uniform"
           Width="980"
           Opacity="0.12"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>

        <Border Margin="12"
            BorderBrush="#1A1A1A"
            BorderThickness="2"
            Background="#E8E8E8">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="165"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- PANEL PRINCIPAL                                         -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="110"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>

                    <!-- ── TITULO ── -->
                    <Border Grid.Row="0" Background="#E8E8E8" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                        <TextBlock Text="Ingreso de Asientos"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1A1A1A"/>
                    </Border>

                    <!-- ── CABECERA ── -->
                    <Grid Grid.Row="1" Margin="10,4,10,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="66"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <!-- FILA 1 -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="mes"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               FontSize="12"/>

                        <ComboBox 
                              Grid.Row="0" Grid.Column="1"
                              Height="24"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Meses}"
                              SelectedItem="{Binding MesSeleccionado}"
                              DisplayMemberPath="mes"
                              SelectedValuePath="mes"
                              />

                        <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="Sub-diario"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               FontSize="12"/>

                        <ComboBox 
                              Grid.Row="0" Grid.Column="3"
                              Height="24"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding SubDiarios}"
                              SelectedItem="{Binding SubDiarioSeleccionado}"
                              DisplayMemberPath="Diario"
                              />

                        <TextBox 
                             Grid.Row="0" Grid.Column="4"
                             Height="24"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             Background="#DDDDDD"
                             FontSize="12"
                             Text="{Binding SubDiarioNombre}"
                             />

                        <TextBlock Grid.Row="0" Grid.Column="5"
                               Text="Referencia"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               FontSize="12"/>

                        <TextBox x:Name="txtReferencia"
                             Grid.Row="0" Grid.Column="6"
                             Height="24"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             Background="#F5F5F5"
                             FontWeight="Bold"
                             FontSize="12"
                             Text="{Binding Referencia}"/>

                        <Image Grid.Row="0" Grid.Column="7"
                           Source="/Assets/logoConCapibara.png"
                           Stretch="Uniform"
                           Margin="8,2,8,2"
                           HorizontalAlignment="Left"/>

                        <!-- FILA 2 -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="LibroReg"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               FontSize="12"/>

                        <ComboBox x:Name="cmbLibro"
                              Grid.Row="1" Grid.Column="1"
                              Height="24"
                              VerticalAlignment="Top"
                              ItemsSource="{Binding Libros}"
                              SelectedItem="{Binding LibroSeleccionado}"
                              DisplayMemberPath="Cod" Margin="0,3,0,0"
                              />

                        <TextBox x:Name="txtLibroNombre"
                             Grid.Row="1" Grid.Column="2"
                             Grid.ColumnSpan="3"
                             Height="24"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             Background="#DDDDDD"
                             FontSize="12"
                             Text="{Binding LibroNombre}"/>

                        <TextBlock Grid.Row="1" Grid.Column="5"
                               Text="Fecha"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               FontSize="12"/>

                        <DatePicker x:Name="dpFecha"
                                Grid.Row="1" Grid.Column="6"
                                Height="24"
                                VerticalAlignment="Center"
                                SelectedDate="{Binding Fecha}"
                                />

                        <TextBlock Grid.Row="1" Grid.Column="8"
                               Text="moneda"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               FontSize="12"/>

                        <ComboBox x:Name="cmbMoneda"
                              Grid.Row="1" Grid.Column="9"
                              Height="24"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Monedas}"
                              SelectedItem="{Binding MonedaSeleccionada}"
                              />

                        <TextBlock Grid.Row="1" Grid.Column="10"
                               Text="cambio"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               FontSize="12"/>

                        <TextBox x:Name="txtTipoCambio"
                             Grid.Row="1" Grid.Column="11"
                             Height="24"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             Background="#F5F5F5"
                             Text="0.0000"
                             TextAlignment="Right"
                             FontSize="12"/>

                        <TextBlock Grid.Row="1" Grid.Column="12"
                               Text="F. venc."
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               FontSize="12"/>

                        <DatePicker x:Name="dpFechaVencimiento"
                                Grid.Row="1" Grid.Column="13"
                                Height="24"
                                VerticalAlignment="Center"
                                SelectedDateFormat="Short"
                                SelectedDate="{Binding FechaVencimiento}"/>
                    </Grid>

                    <!-- ── TABLA PRINCIPAL── -->
                    <Border Grid.Row="2"
                        Margin="10,0,10,6"
                        BorderBrush="#303030"
                        BorderThickness="2"
                        Background="White">
                        <DataGrid x:Name="dgDetalle"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              GridLinesVisibility="All"
                              AlternatingRowBackground="#F3F3F3"
                              RowBackground="White"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FontSize="12"
                              RowHeight="24"
                              ColumnHeaderHeight="28"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ItemsSource="{Binding Detalle}"
                              SelectedItem="{Binding DetalleSeleccionado}">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2A2A2A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="BorderBrush" Value="#555555"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cuenta"
                                                Binding="{Binding PlanCuenta.Codigo}"
                                                Width="95"
                                                MinWidth="95"/>
                                <DataGridTextColumn Header="Descripción"
                                                Binding="{Binding PlanCuenta.Descripcion}"
                                                Width="220"
                                                MinWidth="120"/>
                                <DataGridTextColumn Header="Mond."
                                                Binding="{Binding Moneda}"
                                                Width="58"
                                                MinWidth="58"
                                                IsReadOnly="True"/>
                                <DataGridTextColumn Header="Debe"
                                                Binding="{Binding Debe, StringFormat=N2}"
                                                Width="105"
                                                MinWidth="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Haber"
                                                Binding="{Binding Haber, StringFormat=N2}"
                                                Width="105"
                                                MinWidth="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Td"
                                                Binding="{Binding TipoFacturacion.Cod}"
                                                Width="48"
                                                MinWidth="48"/>
                                <DataGridTextColumn Header="Documento"
                                                Binding="{Binding SerieComprobante}"
                                                Width="125"
                                                MinWidth="100"/>
                                <DataGridTextColumn Header="Ruc"
                                                 Binding="{Binding Tercero.Documento}"
                                                Width="135"
                                                MinWidth="100"/>
                                <DataGridTextColumn Header="Razón Social"
                                                Binding="{Binding Tercero.RazonSocial}"
                                                Width="230"
                                                MinWidth="130"/>
                                <DataGridTextColumn Header="Glosa"
                                                Binding="{Binding Glosa}"
                                                Width="*"
                                                MinWidth="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- ── TABLA RELACION ── -->
                    <Border Grid.Row="3"
                        Margin="10,0,10,6"
                        BorderBrush="#303030"
                        BorderThickness="2"
                        Background="#F8F8F8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Background="#EEEEEE">
                                <TextBlock Text="Asiento Relación / Referencia"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#1A1A1A"/>
                            </Border>

                            <DataGrid x:Name="dgRelacion"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  AlternatingRowBackground="#F3F3F3"
                                  RowBackground="White"
                                  FontSize="12"
                                  RowHeight="24"
                                  ColumnHeaderHeight="28"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#3A3A3A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="BorderBrush" Value="#666666"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Asiento Ref."
                                                    Binding="{Binding AsientoReferencia}"
                                                    Width="140"
                                                    MinWidth="110"/>
                                    <DataGridTextColumn Header="Td"
                                                    Binding="{Binding TipoDocumentoCodigo}"
                                                    Width="48"
                                                    MinWidth="48"/>
                                    <DataGridTextColumn Header="Documento"
                                                    Binding="{Binding Documento}"
                                                    Width="155"
                                                    MinWidth="100"/>
                                    <DataGridTextColumn Header="Ruc"
                                                    Binding="{Binding Ruc}"
                                                    Width="140"
                                                    MinWidth="100"/>
                                    <DataGridTextColumn Header="Razón Social"
                                                    Binding="{Binding RazonSocial}"
                                                    Width="*"
                                                    MinWidth="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ── BOTONERA ── -->
                    <Grid Grid.Row="4" Margin="10,0,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Agregar" Margin="0,5,5,5"
                            Background="#2BBF5A" Foreground="White" FontWeight="Bold" FontSize="12"
                            Command="{Binding AgregarDetalleAsientoCommand}"/>

                        <Button Grid.Column="1" Content="Quitar" Margin="0,5,5,5"
                            Background="#D2452D" Foreground="White" FontWeight="Bold" FontSize="12"
                            Command="{Binding QuitarDetalleCommand}"/>

                        <Button Grid.Column="2" Content="Dif. de&#10;Cambio" Margin="0,5,5,5"
                            Background="#31B66F" Foreground="White" FontWeight="Bold" FontSize="11"
                            Command="{Binding AplicarDiferenciaCommand}"/>

                        <Button Grid.Column="3" Content="Revertir" Margin="0,5,5,5"
                            Background="#B38757" Foreground="White" FontWeight="Bold" FontSize="12"
                            Command="{Binding RevertirDetalleCommand}"/>

                        <Button Grid.Column="4" Content="Pendiente" Margin="0,5,5,5"
                            Background="#5569D6" Foreground="White" FontWeight="Bold" FontSize="12"
                             Command="{Binding AbrirPendientesCommand}"/>

                        <Button Grid.Column="5" Content="Caja" Margin="0,5,5,5"
                            Background="#FF6E1F" Foreground="White" FontWeight="Bold" FontSize="12"
                            Command="{Binding AbrirCajaAsientoCommand}"/>

                        <Button Grid.Column="6" Content="Borrar" Margin="0,5,8,5"
                            Background="#A2291D" Foreground="White" FontWeight="Bold" FontSize="12"
                            Command="{Binding BorrarTodoCommand}"/>

                        <TextBlock Grid.Column="8"
                               Text="Debe"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               FontSize="14"
                               FontWeight="Bold"/>

                        <TextBox x:Name="txtTotalDebe"
                             Grid.Column="9"
                             Margin="0,7,8,7"
                             FontSize="14"
                             FontWeight="Bold"
                             IsReadOnly="True"
                             TextAlignment="Right"
                             Background="#F5F5F5"
                             Text="{Binding TotalDebe, Mode=OneWay}"/>

                        <TextBlock Grid.Column="10"
                               Text="Haber"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               FontSize="14"
                               FontWeight="Bold"/>

                        <TextBox x:Name="txtTotalHaber"
                             Grid.Column="11"
                             Margin="0,7,8,7"
                             FontSize="14"
                             FontWeight="Bold"
                             IsReadOnly="True"
                             TextAlignment="Right"
                             Background="#F5F5F5"
                             Text="{Binding TotalHaber, Mode=OneWay}"/>

                        <TextBlock Grid.Column="12"
                               Text="Difer."
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="Black"/>

                        <TextBox x:Name="txtDiferencia"
                             Grid.Column="13"
                             Margin="0,5,0,5"
                             FontSize="18"
                             FontWeight="Bold"
                             IsReadOnly="True"
                             TextAlignment="Right"
                             Background="#FFF3C4"
                             Foreground="Black"
                             Text="{Binding Diferencia, Mode=OneWay}"/>
                    </Grid>

                    <!-- ── FOOTER ── -->
                    <Grid Grid.Row="5" Background="#DDDDDD">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                           Source="/Assets/logo.png"
                           Stretch="Uniform"
                           Margin="6,2"/>

                        <TextBlock x:Name="txtUsuarioEstado"
                               Grid.Column="1"
                               Text="Usuario"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"/>

                        <TextBlock x:Name="txtFechaEstado"
                               Grid.Column="2"
                               Text="15/03/2026 16:22:15"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"/>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- PANEL DERECHO                                           -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Column="1" Background="#DADADA">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Navegación -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnAnterior"
            Grid.Column="0"
            FontSize="26"
            FontWeight="Bold"
            Content="⮜"
            Background="#BBBBBB"
            BorderBrush="#999999"
            />

                        <Button x:Name="btnSiguiente"
            Grid.Column="1"
            FontSize="26"
            FontWeight="Bold"
            Content="⮞"
            Background="#BBBBBB"
            BorderBrush="#999999"
            />
                    </Grid>

                    <!-- NUEVO BOTON -->
                    <Button 
        Grid.Row="1"
        Content="Agregar Asiento"
        Background="#149191"
        Foreground="White"
        FontSize="14"
        FontWeight="Bold"
       />

                    <Button 
        Grid.Row="2"
        Content="Guardar"
        Background="#2FB35A"
        Foreground="White"
        FontSize="14"
        FontWeight="Bold"
        Command="{Binding GuardarCommand}"
        />

                    <Button x:Name="btnModificar"
        Grid.Row="3"
        Content="Modificar"
        Background="#F0C500"
        Foreground="White"
        FontSize="14"
        FontWeight="Bold"
        Command="{Binding ModificarCommand}"
        IsEnabled="{Binding ModoBuscar}"/>

                    <Button x:Name="btnEliminar"
        Grid.Row="4"
        Content="Eliminar"
        Background="#9D241B"
        Foreground="White"
        FontSize="14"
        FontWeight="Bold"
        Command="{Binding EliminarCommand}"
        IsEnabled="{Binding ModoBuscar}"/>

                    <Button x:Name="btnRevertirAsiento"
        Grid.Row="5"
        Content="Revertir"
        Background="#B38757"
        Foreground="White"
        FontSize="14"
        FontWeight="Bold"
        Command="{Binding RevertirAsientoCommand}"
        IsEnabled="{Binding ModoBuscar}"/>

                    <Button x:Name="btnCopiar"
        Grid.Row="6"
        Content="Copiar Asiento"
        Background="#2F455B"
        Foreground="White"
        FontSize="14"
        FontWeight="Bold"
        IsEnabled="{Binding ModoBuscar}"
        Command="{Binding CopiarAsientoCommand}"/>

                    <Button x:Name="btnVolver"
        Grid.Row="7"
        Content="Volver"
        Background="#D13F2C"
        Foreground="White"
        FontSize="14"
        FontWeight="Bold"
        />

                    <Button x:Name="btnBuscar"
        Grid.Row="8"
        Content="Buscar Asiento"
        Background="#4457C8"
        Foreground="White"
        FontSize="14"
        FontWeight="Bold"
        Command="{Binding BuscarAsientoCommand}"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
